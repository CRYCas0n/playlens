{
  "$meta": {
    "product": "Playlens — Game Intelligence Platform",
    "version": "1.0.0",
    "description": "Machine-readable design tokens. Mirrors prototype/assets/tokens.css 1:1. If a value differs between the two files, tokens.css is generated from this file and this file wins.",
    "defaultTheme": "dark",
    "namingConvention": "CSS custom property = --<group>-<subgroup>-<name>, e.g. color.bg.canvas -> --bg-canvas, color.score.excellent.solid -> --score-excellent"
  },

  "color": {
    "bg": {
      "canvas":   { "dark": "#0A0B0E", "light": "#FBFBFD", "css": "--bg-canvas",   "use": "Page background. Never put text directly on it without a container." },
      "surface":  { "dark": "#101318", "light": "#FFFFFF", "css": "--bg-surface",  "use": "Default card / panel background." },
      "elevated": { "dark": "#171B22", "light": "#FFFFFF", "css": "--bg-elevated", "use": "Popovers, dropdowns, modals, sticky bars." },
      "inset":    { "dark": "#0D0F13", "light": "#F2F3F7", "css": "--bg-inset",    "use": "Wells: inputs, code, table headers, scroll tracks." },
      "hover":    { "dark": "#1C212A", "light": "#F0F1F5", "css": "--bg-hover",    "use": "Row / list-item hover." },
      "overlay":  { "dark": "rgba(5,6,8,0.74)", "light": "rgba(16,19,24,0.44)", "css": "--bg-overlay", "use": "Modal scrim." }
    },
    "border": {
      "subtle":  { "dark": "#1E232B", "light": "#EBECF0", "css": "--border-subtle",  "use": "Dividers inside a surface." },
      "default": { "dark": "#2A3039", "light": "#DDDFE6", "css": "--border-default", "use": "Card and input borders." },
      "strong":  { "dark": "#3A424E", "light": "#C3C7D1", "css": "--border-strong",  "use": "Hover borders, selected chips." },
      "focus":   { "dark": "#8E73FF", "light": "#6A46EE", "css": "--border-focus",   "use": "Focus ring colour." }
    },
    "text": {
      "primary":   { "dark": "#F4F6F9", "light": "#0F1216", "css": "--text-primary",   "contrastOnCanvas": "17.1:1" },
      "secondary": { "dark": "#A9B2BF", "light": "#4A515C", "css": "--text-secondary", "contrastOnCanvas": "8.6:1" },
      "muted":     { "dark": "#7B838F", "light": "#6B717B", "css": "--text-muted",     "contrastOnCanvas": "4.8:1", "use": "Metadata only. Never body copy." },
      "inverse":   { "dark": "#0A0B0E", "light": "#FFFFFF", "css": "--text-inverse",   "use": "Text on solid brand / score fills." },
      "link":      { "dark": "#B4A0FF", "light": "#5A37D6", "css": "--text-link" }
    },
    "brand": {
      "300": { "dark": "#B4A0FF", "light": "#8E73FF", "css": "--brand-300", "use": "Brand text on dark backgrounds." },
      "500": { "dark": "#7C5CFF", "light": "#7C5CFF", "css": "--brand-500", "use": "Accent: icons, borders, gauges, focus." },
      "600": { "dark": "#6A46EE", "light": "#6A46EE", "css": "--brand-600", "use": "Primary button background. 5.2:1 with #FFFFFF." },
      "700": { "dark": "#5A37D6", "light": "#5A37D6", "css": "--brand-700", "use": "Primary button :active." },
      "subtleBg":     { "dark": "rgba(124,92,255,0.14)", "light": "rgba(124,92,255,0.10)", "css": "--brand-subtle" },
      "subtleBorder": { "dark": "rgba(124,92,255,0.38)", "light": "rgba(124,92,255,0.30)", "css": "--brand-border" }
    },
    "score": {
      "$doc": "Four tiers. Colour is NEVER the only signal — every score is rendered with its tier word (Excellent / Good / Mixed / Poor / Not rated) and, in the hero, with a proportional arc.",
      "excellent": { "range": "85-100", "label": "Excellent", "solid": "#22C58C", "text": "#3FDDA0", "bg": "rgba(34,197,140,0.14)", "border": "rgba(34,197,140,0.40)", "css": "--score-excellent" },
      "good":      { "range": "70-84",  "label": "Good",      "solid": "#A8C64F", "text": "#C2DC6E", "bg": "rgba(168,198,79,0.14)", "border": "rgba(168,198,79,0.40)", "css": "--score-good" },
      "mixed":     { "range": "50-69",  "label": "Mixed",     "solid": "#E3A93E", "text": "#F0C065", "bg": "rgba(227,169,62,0.14)", "border": "rgba(227,169,62,0.40)", "css": "--score-mixed" },
      "poor":      { "range": "0-49",   "label": "Poor",      "solid": "#E85C50", "text": "#FF8478", "bg": "rgba(232,92,80,0.14)",  "border": "rgba(232,92,80,0.40)",  "css": "--score-poor" },
      "none":      { "range": "null",   "label": "Not rated", "solid": "#4A515C", "text": "#7B838F", "bg": "rgba(122,131,143,0.12)","border": "rgba(122,131,143,0.34)","css": "--score-none" }
    },
    "semantic": {
      "$doc": "Deliberately shares hues with the score ramp so 'good/bad' reads identically everywhere in the product, including Monitoring.",
      "success": { "solid": "#22C58C", "text": "#3FDDA0", "bg": "rgba(34,197,140,0.14)" },
      "warning": { "solid": "#E3A93E", "text": "#F0C065", "bg": "rgba(227,169,62,0.14)" },
      "error":   { "solid": "#E85C50", "text": "#FF8478", "bg": "rgba(232,92,80,0.14)" },
      "info":    { "solid": "#5B8CFF", "text": "#8FB0FF", "bg": "rgba(91,140,255,0.14)" },
      "neutral": { "solid": "#4A515C", "text": "#A9B2BF", "bg": "rgba(122,131,143,0.12)" }
    }
  },

  "typography": {
    "family": {
      "display": { "value": "'Space Grotesk', 'Inter', system-ui, sans-serif", "css": "--font-display", "use": "Headings, game titles, score numerals. Gives the product its gaming/editorial voice." },
      "body":    { "value": "'Inter', system-ui, -apple-system, sans-serif",   "css": "--font-body",    "use": "All UI and prose." },
      "mono":    { "value": "'JetBrains Mono', ui-monospace, monospace",       "css": "--font-mono",    "use": "IDs, timestamps, platform codes, monitoring tables." }
    },
    "scale": {
      "display-1": { "size": 56,   "lineHeight": 1.04, "weight": 700, "tracking": "-0.03em",  "family": "display", "use": "Game Details hero title (desktop)." },
      "display-2": { "size": 42,   "lineHeight": 1.08, "weight": 700, "tracking": "-0.025em", "family": "display", "use": "Home spotlight title, hero title on laptop." },
      "h1":        { "size": 32,   "lineHeight": 1.16, "weight": 600, "tracking": "-0.02em",  "family": "display" },
      "h2":        { "size": 25,   "lineHeight": 1.22, "weight": 600, "tracking": "-0.015em", "family": "display" },
      "h3":        { "size": 19,   "lineHeight": 1.32, "weight": 600, "tracking": "-0.01em",  "family": "display" },
      "h4":        { "size": 16,   "lineHeight": 1.36, "weight": 600, "tracking": "0",        "family": "body" },
      "body-lg":   { "size": 17,   "lineHeight": 1.62, "weight": 400, "tracking": "0",        "family": "body", "use": "Editorial consensus paragraphs." },
      "body":      { "size": 15,   "lineHeight": 1.6,  "weight": 400, "tracking": "0",        "family": "body" },
      "body-sm":   { "size": 13.5, "lineHeight": 1.55, "weight": 400, "tracking": "0",        "family": "body" },
      "caption":   { "size": 12,   "lineHeight": 1.45, "weight": 400, "tracking": "0",        "family": "body", "use": "Provenance lines, timestamps." },
      "label":     { "size": 12,   "lineHeight": 1.1,  "weight": 600, "tracking": "0.08em",   "family": "body", "transform": "uppercase" },
      "label-sm":  { "size": 10.5, "lineHeight": 1.1,  "weight": 700, "tracking": "0.10em",   "family": "body", "transform": "uppercase" },
      "mono-sm":   { "size": 12,   "lineHeight": 1.45, "weight": 500, "tracking": "0",        "family": "mono" }
    },
    "score": {
      "$doc": "Score numerals have their own ramp so a score is never confused with body text. Always tabular-nums, always display family, always weight 700.",
      "score-xl": { "size": 60, "lineHeight": 1.0, "weight": 700, "tracking": "-0.04em", "use": "Metascore in the Game Details verdict gauge." },
      "score-lg": { "size": 34, "lineHeight": 1.0, "weight": 700, "tracking": "-0.03em", "use": "Userscore in verdict, Home spotlight." },
      "score-md": { "size": 22, "lineHeight": 1.0, "weight": 700, "tracking": "-0.02em", "use": "Per-platform score, monitoring KPI." },
      "score-sm": { "size": 16, "lineHeight": 1.0, "weight": 700, "tracking": "-0.01em", "use": "GameCard badge." },
      "score-xs": { "size": 13, "lineHeight": 1.0, "weight": 700, "tracking": "0",       "use": "SimilarGameCard, inline score chip." }
    }
  },

  "spacing": {
    "$doc": "4px base grid. Only these values may be used for padding, gap and margin.",
    "0": 0, "1": 2, "2": 4, "3": 6, "4": 8, "5": 12, "6": 16, "7": 20,
    "8": 24, "9": 32, "10": 40, "11": 48, "12": 64, "13": 80, "14": 96, "15": 128
  },

  "radius": {
    "xs": 4, "sm": 6, "md": 10, "lg": 14, "xl": 20, "2xl": 28, "full": 999,
    "$usage": { "chip": "full", "button": "md", "input": "md", "card": "lg", "cover": "md", "panel": "xl", "modal": "xl" }
  },

  "shadow": {
    "sm": "0 1px 2px rgba(0,0,0,0.40)",
    "md": "0 4px 14px rgba(0,0,0,0.45)",
    "lg": "0 14px 36px rgba(0,0,0,0.50)",
    "xl": "0 28px 72px rgba(0,0,0,0.55)",
    "focus": "0 0 0 2px var(--bg-canvas), 0 0 0 4px var(--border-focus)",
    "$doc": "On the dark theme, elevation is communicated mainly by background step (canvas -> surface -> elevated) and border, not by heavy shadow. Shadows are used only for true overlays."
  },

  "breakpoints": {
    "$doc": "Mobile-first media queries in CSS; the design is authored desktop-first.",
    "sm": 390, "md": 768, "lg": 1024, "xl": 1280, "2xl": 1440
  },

  "layout": {
    "containerMax": 1360,
    "gutter": { "mobile": 16, "tablet": 24, "desktop": 32 },
    "topbarHeight": { "desktop": 64, "mobile": 56 },
    "catalogSidebarWidth": 264,
    "gameDetailsContentMax": 760,
    "gridColumns": { "mobile": 2, "tablet": 3, "laptop": 4, "desktop": 5 }
  },

  "motion": {
    "duration": { "instant": 80, "fast": 140, "base": 200, "slow": 300, "slower": 480 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "out":      "cubic-bezier(0, 0, 0, 1)",
      "in":       "cubic-bezier(0.3, 0, 1, 1)",
      "spring":   "cubic-bezier(0.2, 0.8, 0.2, 1)"
    },
    "$doc": "No motion over 480ms. Everything respects prefers-reduced-motion: reduce (all transitions/animations collapse to 1ms)."
  },

  "zIndex": { "base": 0, "sticky": 100, "dropdown": 200, "overlay": 300, "modal": 400, "toast": 500, "tooltip": 600 },

  "opacity": { "disabled": 0.45, "scrim": 0.74, "ghost": 0.6 },

  "aspectRatio": {
    "cover": "3 / 4",
    "hero": "16 / 6",
    "video": "16 / 9",
    "similarCover": "3 / 4"
  }
}
