# Playlens configuration.
#
# Copy to .env and edit. Only ADMIN_TOKEN has to be set to run; everything else has a
# working default. app/config.py is the only place in the codebase that reads the
# environment, so this file and that file are the complete surface (ADR-019 T5).
#
# The three feature keys (LLM, YouTube) are ABSENT here on purpose: the service runs
# without them, and pretending otherwise would hide that from whoever deploys it.

# ---------------------------------------------------------------------- application
APP_ENV=development                  # development | test | production
APP_NAME=Playlens
LOG_LEVEL=INFO
LOG_FORMAT=json                      # console for readable local logs
CONTACT_URL=https://example.com/contact

# ---------------------------------------------------------------------- database
# SQLite is the default so `make dev` works with nothing installed. Production is
# PostgreSQL 16: the schema is identical and the migrations run on both (ADR-018).
DATABASE_URL=sqlite+pysqlite:///./playlens.db
# DATABASE_URL=postgresql+psycopg://playlens:playlens@localhost:5432/playlens
DB_POOL_SIZE=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_MAX_OVERFLOW=10

# ---------------------------------------------------------------------- api
API_PREFIX=/api/v1
# REQUIRED. Guards every mutating endpoint. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Admin endpoints return 503 rather than opening up when this is empty.
ADMIN_TOKEN=
CORS_ALLOW_ORIGINS=                  # comma-separated; empty disables CORS entirely
PUBLIC_RATE_LIMIT_PER_MIN=120
ADMIN_RATE_LIMIT_PER_MIN=10
OFFSET_HARD_LIMIT=10000

# ---------------------------------------------------------------------- source
METACRITIC_SOURCE=json_api           # json_api | html (html is the documented fallback)
METACRITIC_BASE_URL=https://www.metacritic.com
METACRITIC_API_BASE_URL=https://backend.metacritic.com
# METACRITIC_API_KEY is NOT a secret: it is a public value from Metacritic's own
# frontend, and Release 0 verified the server ignores it entirely. It is left in the
# defaults so the service works out of the box; override only if the site changes.
# 2 requests/second with a burst of 4. Raising this is a decision about someone else's
# infrastructure -- the config rejects anything above 5 (ADR-004).
METACRITIC_RPS=2.0
METACRITIC_BURST=4
REQUEST_TIMEOUT_S=20
REQUEST_MAX_RETRIES=5
CIRCUIT_FAIL_THRESHOLD=5
CIRCUIT_RESET_TIMEOUT_S=300
# Consecutive parse failures before the crawl stops and reports schema drift rather
# than quietly writing empty games (ADR-005).
SCHEMA_DRIFT_THRESHOLD=10
REQUEST_CONNECT_TIMEOUT_S=5
REQUEST_BACKOFF_BASE_S=1.0  # full jitter, doubling to the max below
REQUEST_BACKOFF_MAX_S=32.0

# ---------------------------------------------------------------------- crawling
CRAWL_ENABLED=true
CRAWL_INTERVAL_CRON=7 * * * *        # hourly, off the hour
CRAWL_TIMEZONE=UTC
# 20, not 40. New Releases returns 20 per page and repeats ~18 of them the next day,
# so a higher ceiling spends requests on games already indexed (C-26).
CRAWL_MAX_GAMES_PER_RUN=20
NEW_RELEASES_LIMIT=20
CRAWL_ITEM_LEASE_TTL_S=1800
RECONCILE_ENABLED=true
RECONCILE_CRON=0 3 * * 0
BROWSE_PAGE_SIZE=24
BROWSE_MAX_OFFSET=100000
CRAWL_ITEM_MAX_ATTEMPTS=3
RECONCILE_MAX_NEW=2000  # ceiling for one backfill pass

# ---------------------------------------------------------------------- reviews
REVIEWS_ENABLED=true
REVIEWS_PAGE_SIZE=100                # the API caps critic pages at 10 regardless (C-01)
REVIEWS_CRITIC_CAP=200
REVIEWS_USER_CAP=500
REVIEWS_MAX_PLATFORMS=3
REVIEWS_MIN_INTERVAL_H=24
REVIEWS_FULL_RESYNC_DAYS=30
REVIEWS_MIN_PLATFORM_CRITICS=3  # below this a platform is not worth a request
REVIEWS_MIN_PLATFORM_USERS=50
REVIEWS_STALE_PAGE_TOLERANCE=2  # pages of overlap accepted before a full resync
REVIEWS_INCREMENTAL_MAX_PAGES=5

# ---------------------------------------------------------------------- scoring
# A player score of 0 backed by fewer than this many ratings is treated as ABSENT, not
# as zero. All four zeros in the Release 0 sample had <=3 ratings; the lowest genuine
# score was 0.5 from 6382 (ADR-002).
USERSCORE_ZERO_MIN_RATINGS=20
LOW_SAMPLE_THRESHOLD=20
AGREEMENT_THRESHOLD=7                # points, on the 0-100 axis, before "disagree"
GAP_MIN_POINTS=7
PLATFORM_GAP_MIN_POINTS=10

# ---------------------------------------------------------------------- ai
# OFF by default. With it off, summaries stay in their pending state and the UI says
# so; every other feature works. This is a supported product state, not a broken one.
LLM_ENABLED=false
# Which service writes the summaries. The model name must match the provider -- the app
# refuses to start on a mismatch rather than failing hours later on the first summary.
#   anthropic  ->  LLM_MODEL=claude-sonnet-5   (also claude-opus-5, claude-haiku-4-5)
#   openai     ->  LLM_MODEL=gpt-4o            (also gpt-4o-mini, gpt-4.1, o4-mini)
#   fixture    ->  a deterministic stand-in, for tests. Costs nothing, means nothing
#   null       ->  off, same as LLM_ENABLED=false
LLM_PROVIDER=anthropic               # anthropic | openai | null | fixture
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
AI_DAILY_COST_LIMIT_USD=10
AI_MAX_CALLS_PER_HOUR=100
SUMMARY_MIN_CRITIC_REVIEWS=5
SUMMARY_MIN_USER_REVIEWS=20
# A claim must be supported by this many cited reviews or it is discarded before
# anyone reads it (ADR-008).
CLAIM_MIN_SUPPORT=3
CLAIM_MIN_SUPPORT_SMALL_CORPUS=2
TEMPORAL_MIN_SPAN_DAYS=30
LLM_MAX_OUTPUT_TOKENS=4000
LLM_TIMEOUT_S=300
LLM_MAX_RETRIES=6
AI_MAX_INPUT_TOKENS=60000  # corpus is trimmed to fit rather than truncated blindly
AI_MIN_NEW_REVIEWS=10  # how much has to change before regenerating
AI_MIN_NEW_RATIO=0.2
AI_SCORE_MOVE_POINTS=3  # a score that moved this far justifies a new summary
AI_MAX_SUMMARY_AGE_DAYS=90
CORPUS_MIN_CHARS=80  # shorter reviews carry no evidence and are dropped
CORPUS_MAX_REVIEW_CHARS=1500
CORPUS_MIN_STRATUM_SHARE=0.15  # guarantees a minority opinion survives sampling
SMALL_CORPUS_THRESHOLD=20  # below this the relaxed support threshold applies
SUMMARY_HISTORY_KEEP=10
SNAPSHOT_RETENTION_DAYS=90  # and only if no current summary cites it
PROMPT_VERSION_CRITIC=critic-v2  # changing a prompt version forces regeneration
PROMPT_VERSION_USER=user-v2
PROMPT_VERSION_LETSPLAY=letsplay-v2
PROMPT_VERSION_GAP=gap-v2

# ---------------------------------------------------------------------- similarity
SIMILARITY_TOP_N=12
SIMILARITY_MIN_SCORE=0.34            # below this the rail is empty rather than padded
SIMILARITY_W_METADATA=0.62
SIMILARITY_W_ASPECT=0.26
SIMILARITY_W_LEXICAL=0.12
REASON_MIN_CONTRIBUTION=0.18         # below this no reason chip is shown at all
SIMILARITY_CANDIDATE_LIMIT=300  # phase one shortlist before scoring
SIMILARITY_REFRESH_STALE_DAYS=7
SIMILARITY_REFRESH_CRON=0 4 * * *

# ---------------------------------------------------------------------- youtube
# OFF by default: there is no Data API key (OQ-B2), and the transcript path is not
# verified in a target deployment (OQ-V5). The code, its tests and its fixtures are
# present and pass. Turning it on is this flag plus a key.
YOUTUBE_ENABLED=false
YOUTUBE_API_KEY=
YOUTUBE_DAILY_UNIT_BUDGET=9500       # one discovery costs 101 units -> ~94 games/day
YT_MIN_SCORE=60
YT_MIN_DURATION_S=600
YT_MAX_DURATION_S=25200
YT_MIN_TRANSCRIPT_CHARS=2000         # below this a response is a provider FAILURE
YT_TRANSCRIPT_PROVIDERS=ytdlp,hosted_api,metadata_only
YT_TRANSCRIPT_API_URL=
YT_TRANSCRIPT_API_KEY=
YT_ASR_ENABLED=false
YOUTUBE_SEARCH_MAX_RESULTS=25
YT_ALLOWED_LANGS=en
YT_RESEARCH_AFTER_DAYS=30  # how long before a game with no video is searched again
YT_PROXY_URL=

# ---------------------------------------------------------------------- worker
WORKER_QUEUES=crawl,enrich,ai
# One worker process runs one job at a time, deliberately. To do more at once, run more
# worker processes: docker compose up -d --scale worker=4
JOB_LEASE_TTL_S=900                  # a job whose worker dies is reclaimed after this
SCHEDULER_TICK_INTERVAL_S=20
WORKER_POLL_INTERVAL_S=1.0
JOB_RETRY_BACKOFF_BASE_S=2.0
JOB_RETRY_BACKOFF_MAX_S=600

# ---------------------------------------------------------------------- monitoring
SSE_HEARTBEAT_S=15
SSE_MAX_CLIENTS=50
EVENTS_RETENTION_DAYS=30
JOBS_RETENTION_DAYS=90
METRICS_ENABLED=true
SSE_POLL_INTERVAL_MS=400
SSE_MAX_BACKLOG=2000  # further behind than this and the client gets a fresh snapshot
CRAWL_ITEMS_RETENTION_DAYS=180

# ---------------------------------------------------------------------- web
# The image proxy's entire SSRF surface: an exact host allow-list and a fixed set of
# widths. Adding a host here is a security decision (ADR-019 T4).
IMAGE_PROXY_ENABLED=true
IMAGE_ALLOWED_HOSTS=www.metacritic.com,i.ytimg.com,img.youtube.com
IMAGE_ALLOWED_WIDTHS=96,200,320,480,640
IMAGE_MAX_BYTES=8388608
# false serves the system font stack and makes the page load with no third-party
# request at all. The CSP is derived from this flag either way.
WEB_FONTS_ENABLED=true
IMAGE_CACHE_DIR=.cache/img
IMAGE_CACHE_MAX_MB=512
IMAGE_FETCH_TIMEOUT_S=10
